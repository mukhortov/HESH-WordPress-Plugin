{
	"name": "html-editor-syntax-highlighter",
	"version": "3.0.0-dev",
	"private": true,
	"description": "Syntax Highlighting in WordPress HTML Editor",
	"license": "GPL-2.0-or-later",
	"author": "Peter Mukhortov (https://mukhortov.com)",
	"contributors": [
		"James Bradford (http://bradford.digital/)"
	],
	"homepage": "https://wordpress.org/plugins/html-editor-syntax-highlighter/",
	"repository": {
		"type": "git",
		"url": "https://github.com/mukhortov/HESH-WordPress-Plugin.git"
	},
	"bugs": {
		"url": "https://github.com/mukhortov/HESH-WordPress-Plugin/issues"
	},
	"engines": {
		"node": ">=22"
	},
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"scripts": {
		"grammar": "lezer-generator --typeScript src/lang-shortcode/shortcode.grammar -o src/lang-shortcode/parser.ts",
		"prebuild": "npm run grammar",
		"build": "wp-scripts build",
		"prestart": "npm run grammar",
		"start": "wp-scripts start",
		"package": "npm run build && node bin/package.mjs",
		"typecheck": "npm run grammar && tsc --noEmit",
		"lint:js": "wp-scripts lint-js src tests bin",
		"lint:css": "wp-scripts lint-style \"src/**/*.scss\"",
		"lint": "npm run lint:js && npm run lint:css",
		"pretest:unit": "npm run grammar",
		"test:unit": "wp-scripts test-unit-js",
		"test:e2e": "playwright test",
		"plugin-check": "node bin/plugin-check.mjs",
		"screenshots": "node bin/screenshots.mjs",
		"test": "npm run typecheck && npm run test:unit",
		"playground": "wp-playground-cli start --path=dist/html-editor-syntax-highlighter --wp=6.5 --php=7.4 --reset"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.4",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-html": "^6.4.12",
		"@codemirror/language": "^6.13.1",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.6",
		"@codemirror/theme-one-dark": "^6.1.3",
		"@codemirror/view": "^6.43.15",
		"@lezer/common": "^1.5.4",
		"@lezer/highlight": "^1.2.5",
		"@lezer/lr": "^1.4.11",
		"@replit/codemirror-emacs": "^6.1.0",
		"@replit/codemirror-vim": "^6.4.0",
		"@replit/codemirror-vscode-keymap": "^6.0.2",
		"@uiw/codemirror-theme-dracula": "^4.25.12",
		"@uiw/codemirror-theme-eclipse": "^4.25.12",
		"@uiw/codemirror-theme-github": "^4.25.12",
		"@uiw/codemirror-theme-gruvbox-dark": "^4.25.12",
		"@uiw/codemirror-theme-material": "^4.25.12",
		"@uiw/codemirror-theme-monokai": "^4.25.12",
		"@uiw/codemirror-theme-nord": "^4.25.12",
		"@uiw/codemirror-theme-solarized": "^4.25.12"
	},
	"devDependencies": {
		"@lezer/generator": "^1.8.1",
		"@playwright/test": "^1.64.1",
		"@types/react": "^19.3.0",
		"@wordpress/api-fetch": "^8.0.0",
		"@wordpress/components": "^43.0.0",
		"@wordpress/core-data": "^9.0.0",
		"@wordpress/data": "^11.0.0",
		"@wordpress/dom-ready": "^5.0.0",
		"@wordpress/element": "^10.0.0",
		"@wordpress/i18n": "^7.0.0",
		"@wordpress/scripts": "^37.0.0",
		"@wp-playground/cli": "^3.1.60",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
}
